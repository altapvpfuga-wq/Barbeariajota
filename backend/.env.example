# ============================================================
#  Barbearia do Jota - variaveis de ambiente
#  Copie para .env e preencha. No Render, configure em
#  Environment -> Environment Variables.
# ============================================================

# --- Pagamento ---
# Provedor ativo (padrao: infinitepay). Troque para outro banco
# seguindo backend/pagamento/README.md
PAGAMENTO_PROVIDER=infinitepay

# modo: link_unico (recomendado) | link_fixo
MODO_PAGAMENTO=link_unico

# valor do sinal em reais
SIGNAL_VALUE=10

# URL publica do backend (para webhook/redirect do pagamento)
PUBLIC_BASE_URL=https://barbearia-jota-api-2026.onrender.com

# PIN do painel (barbeiro)
PIN_PAINEL=1234

# --- InfinitePay (padrao) ---
INFINITYPAY_API_KEY=
INFINITYPAY_HANDLE=
INFINITYPAY_LINK=
INFINITYPAY_LINK_SLUG=

# --- Exemplo de outro banco (descomente e preencha se trocar) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# --- Firebase (push notifications) ---
# Cole o JSON da service account como string, ou use os arquivos
# firebase-service-account.json / firebase-service-account-painel.json
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PAINEL=

# --- Outros ---
PORT=3001
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=bjota-ag-7k2m9xI
